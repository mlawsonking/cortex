{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "calendar",
  "description": "Merged Sonarr episode + Radarr release calendar for the next N days, date-sorted. 'kind' is semantic so the UI chooses its own iconography.",
  "type": "object",
  "additionalProperties": false,
  "required": ["days", "items"],
  "properties": {
    "days": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "kind", "title", "detail"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "kind": { "type": "string", "enum": ["episode", "movie", "other"] },
          "title": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
