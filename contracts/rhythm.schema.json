{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rhythm",
  "description": "I1 Rhythm Map: weekday x hour play-count matrices from Tautulli history. Matrices are 7 rows (Monday=0 .. Sunday=6, python tm_wday) of 24 hourly counts, LOCAL time. total_plays is the honest sample size - a card must surface it, because a heat map over 30 plays is a hint, not a habit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["window_days", "total_plays", "movies", "episodes", "all", "users", "top_slots"],
  "properties": {
    "window_days": { "type": "integer", "minimum": 1 },
    "total_plays": { "type": "integer", "minimum": 0 },
    "movies": { "type": "integer", "minimum": 0 },
    "episodes": { "type": "integer", "minimum": 0 },
    "all": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "type": "integer", "minimum": 0 } }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "plays", "matrix"],
        "properties": {
          "user": { "type": "string" },
          "plays": { "type": "integer", "minimum": 0 },
          "matrix": {
            "type": "array", "minItems": 7, "maxItems": 7,
            "items": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "top_slots": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weekday", "hour", "plays"],
        "properties": {
          "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "plays": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
