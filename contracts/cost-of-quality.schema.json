{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cost-of-quality",
  "description": "I10 Cost of Quality: what each Radarr quality profile costs in disk (films, total, average, its three biggest files) and the REAL G:-fill slope - a daily-aggregated, bulk-move-corrected least-squares fit over the dashboard metrics series, which replaces the legacy sub-3-day forecast. Read-only: informs policy, carries no verb. slope_gb_per_week and full_in_years are null whenever no series supports them; forecast_source always names where the projection came from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles", "movies_total_gb", "g_free_gb", "g_total_gb", "slope_gb_per_week", "full_in_years", "forecast_source", "note"],
  "properties": {
    "profiles": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "films", "total_gb", "avg_gb", "biggest"],
        "properties": {
          "profile": { "type": "string", "minLength": 1 },
          "films": { "type": "integer", "minimum": 1 },
          "total_gb": { "type": "number", "minimum": 0 },
          "avg_gb": { "type": "number", "minimum": 0, "maximum": 200 },
          "biggest": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "gb"],
              "properties": {
                "title": { "type": "string" },
                "gb": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "movies_total_gb": { "type": "number", "minimum": 0 },
    "g_free_gb": { "type": "number", "minimum": 0 },
    "g_total_gb": { "type": "number", "minimum": 0 },
    "slope_gb_per_week": { "type": ["number", "null"] },
    "full_in_years": { "type": ["number", "null"], "minimum": 0 },
    "forecast_source": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 }
  }
}
